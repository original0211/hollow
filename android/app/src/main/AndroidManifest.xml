<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Foreground service (API 34 type regime, verified NP-1114-30):
         base permission + the specialUse type permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Notification visibility for the FGS notice (runtime, API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- VpnService skeleton. foregroundServiceType=specialUse with the
             subtype property, per the NP-1114-30 FGS verification record
             (files/m3/fgs-verification-record.md). Data plane (Builder
             establish) arrives in M3-2; this declaration is the consent +
             foreground form only. -->
        <service
            android:name=".HollowVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hollow encrypted VPN tunnel: the VpnService must stay foreground for the whole tunnel session" />
        </service>
    </application>
</manifest>
